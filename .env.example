SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Tashkent

# Parolni tiklash kodi yuboriladigan pochta (bo'sh qolsa xat server konsoliga chiqadi)
# Gmail uchun: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_PASSWORD — Google "App password" (oddiy parol emas)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# DEBUG=False bo'lganda HTTPS, xavfsiz cookie va HSTS avtomatik yoqiladi.
# Nginx kabi proksi orqasida bo'lsa: BEHIND_PROXY=True. Faqat sinash uchun HTTPS yo'naltirishni o'chirish: SECURE_SSL_REDIRECT=False
# BEHIND_PROXY=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
