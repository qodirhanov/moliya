SECRET_KEY=your-secret-key-here
# Standart xavfsiz: False. Faqat o'z kompyuteringizda ishlab chiqishda True qiling (aks holda HTTPS'ga
# yo'naltirish, HSTS va WhiteNoise yoqiladi). Serverga nusxalangan .env da True qolib ketmasin
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Tashkent

# Parolni tiklash kodi yuboriladigan pochta (bo'sh qolsa xat server konsoliga chiqadi)
# Gmail uchun: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_PASSWORD — Google "App password" (oddiy parol emas)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ---------- Serverga chiqarish (batafsil: DEPLOY.md) ----------
# DEBUG=False bo'lganda HTTPS, xavfsiz cookie va HSTS avtomatik yoqiladi.
# DEBUG=False
# ALLOWED_HOSTS=moliya.uz,www.moliya.uz
# CSRF_TRUSTED_ORIGINS=https://moliya.uz,https://www.moliya.uz

# Admin panel manzili — standart "admin" o'rniga taxmin qilib bo'lmaydigan nom
# ADMIN_URL=boshqaruv-7x2k
# Akkauntlar paneli manzili (navbarda havola yo'q, standart: panel)
# PANEL_URL=nazorat-4m9q

# Nginx kabi proksi orqasida bo'lsa: BEHIND_PROXY=True (NUM_PROXIES avtomatik 1 bo'ladi).
# Proksi bo'lmasa qo'shmang — aks holda foydalanuvchi soxta IP yozib cheklovlarni aylanib o'tadi
# BEHIND_PROXY=True
# NUM_PROXIES=1

# Faqat sinash uchun HTTPS yo'naltirishni o'chirish: SECURE_SSL_REDIRECT=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Bir nechta server jarayoni (worker) bo'lsa Redis tavsiya etiladi (pip install redis).
# Berilmasa login bloklash va cheklov hisoblagichlari bazada saqlanadi
# REDIS_URL=redis://127.0.0.1:6379/1

# Moliya yordamchisi: odatda bepul (ma'lumotnoma qidiruvi). Claude API kaliti berilsa, javobni Claude yozadi (pullik)
# ANTHROPIC_API_KEY=sk-ant-...
# Yoki Google Gemini (tekin rejasi bor, kalit: https://aistudio.google.com → Get API key). ANTHROPIC_API_KEY bo'lsa u ustun.
# Shu kalit ovozli yordamchini ham aqlli qiladi (tekin): qoidalar tushunmagan gapni Gemini tahlil qiladi va
# OPENAI_API_KEY bo'lmasa ovoz yozuvini ham Gemini taniydi.
# Tekin rejada Google so'rovlarni o'z mahsulotlarini yaxshilash uchun ishlatishi mumkin: yordamchiga faqat savol va
# qo'llanma, ovozli buyruqqa esa gap, ovoz yozuvi va hamyon/turkum/qarz/maqsad nomlari yuboriladi (qoldiq va amallar emas).
# GEMINI_API_KEY=...
# Model nomi o'zgarib turadi; ishlamay qolsa AI Studio'dagi joriy Flash modelini yozing
# GEMINI_MODEL=gemini-flash-latest
# Asosiy model band bo'lsa (tekin rejada tez-tez) navbat bilan shular ishlatiladi
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Ovozli yordamchi: brauzer o'zbekcha nutqni tanimasa (Firefox, internet/til xatosi yoki gap tushunilmasa),
# ovoz yozuvi OpenAI orqali matnga aylantiriladi (pullik, ~$0.006/daqiqa). Berilmasa — GEMINI_API_KEY bo'lsa Gemini (tekin), aks holda faqat brauzer
# OPENAI_API_KEY=sk-...
# Model: gpt-4o-transcribe (aniqroq, standart) yoki whisper-1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Ovozli yordamchi javobini ravon o'zbekcha ovozda o'qish. Eng yaxshisi — Microsoft Azure Speech: haqiqiy o'zbek
# ovozlari (Madina — ayol, Sardor — erkak), oyiga 500 000 belgigacha bepul. portal.azure.com → Speech service yarating,
# "Keys and Endpoint" dan kalit va region (masalan westeurope) oling.
# Berilmasa va OPENAI_API_KEY bo'lsa — OpenAI ovozi (biroz urg'u bilan); hech biri bo'lmasa — brauzer ovozi
#
# VoiceLab (voicelab.uz) — o'zbek tiliga ixtisoslashgan ovoz (javobni o'qish) va nutqni tanish; berilsa ovozda
# o'qishda birinchi, nutqni tanishda OpenAI'dan keyin ishlatiladi.
# Kalit: voicelab.uz → Dasturchi → API kalitlar. «Kalitni cheklash» yoqilgan, ruxsatlar: Matnni nutqqa — Yozish,
# Nutqdan matnga — Ruxsat (yuborish + natijani o'qish), Ovozlar — O'qish, qolganlari — Ruxsat yo'q.
# Bepul tarif oyiga 2 000 kredit (2 000 belgi yoki 5 daqiqa nutq, umumiy); tugasa avtomatik Azure/Gemini yoki
# brauzerga o'tiladi.
# VOICELAB_API_KEY=vlk_...
# Ovoz ID lari (ixtiyoriy): python manage.py voicelab_voices
# VOICELAB_VOICE_FEMALE=voice_...
# VOICELAB_VOICE_MALE=voice_...
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Yordam bo'limiga foydalanuvchi yozsa shu manzillarga xat keladi (vergul bilan).
# Berilmasa — admin panelni ko'ra oladigan xodimlarning emaili (Django admin → foydalanuvchi → Email)
# SUPPORT_NOTIFY_EMAILS=admin@example.com
